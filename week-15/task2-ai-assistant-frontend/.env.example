# Server-side destination used by the /backend rewrite.
BACKEND_URL=http://localhost:8000

# Public because Google requires the browser to initialize its sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-your-google-web-client-id

# Keep this same-origin path for first-party authentication cookies.
NEXT_PUBLIC_API_URL=/backend/api/v1
